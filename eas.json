{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://stalk-api.ahsanul.dev",
        "EXPO_PUBLIC_SOCKET_URL": "https://stalk-api.ahsanul.dev"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://stalk-api.ahsanul.dev",
        "EXPO_PUBLIC_SOCKET_URL": "https://stalk-api.ahsanul.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
